{
  "name": "@next-architect/cli",
  "version": "0.1.0",
  "description": "CLI for next-architect",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "next-architect": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@next-architect/core": "workspace:*",
    "@next-architect/graph": "workspace:*",
    "@next-architect/parser": "workspace:*",
    "@next-architect/reporters": "workspace:*",
    "@next-architect/rules": "workspace:*"
  },
  "license": "MIT"
}
