{
  "name": "next-architect-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Architecture intelligence for Next.js applications",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "next-architect": "node packages/next-architect/dist/bin.js",
    "corpus:arch001": "node corpus/arch001/run.mjs",
    "corpus:arch002": "node corpus/arch002/run.mjs",
    "corpus:arch003": "node corpus/arch003/run.mjs",
    "corpus:arch004": "node corpus/arch004/run.mjs",
    "corpus:arch005": "node corpus/arch005/run.mjs",
    "corpus:smoke": "node corpus/smoke/run.mjs",
    "corpus:perf": "node corpus/perf/run.mjs",
    "corpus:all": "pnpm corpus:arch001 && pnpm corpus:arch002 && pnpm corpus:arch003 && pnpm corpus:arch004 && pnpm corpus:arch005 && pnpm corpus:smoke && pnpm corpus:perf",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
